# ============================================================
# RelayGate .gitignore
# 原则：只忽略「依赖 / 密钥 / 运行时数据 / 工具残留」四类内容。
# 文档（docs/）与脚本（scripts/）属于项目资产，必须入库。
# ============================================================

# ---------- 依赖 ----------
node_modules/
web/node_modules/

# ---------- 环境与密钥 ----------
.env
.env.local
.env.production
**/os-crypt-key.txt
decrypted-*.json
test-*-request.json

# ---------- 运行时数据（WORKSPACE_DIR=./output）----------
# SQLite 凭据库、加密密钥、虚拟模型运行态、导出的 json 状态
output/
*.db
*.db-shm
*.db-wal
.trae-api/

# ---------- 运行时日志（logs/ 由 start.bat 与 log/ 落盘）----------
logs/

# ---------- 产品备份目录（jobs/backup.js 的输出契约）----------
backups/

# ---------- 工具 / 会话残留 ----------
.history/
.mimosa/
.workbuddy/
_session_analysis/
session-content/
_analysis/
__pycache__/
*.pyc
tmp-userdata/
**/tmp-userdata/

# ---------- 临时探针与调试输出（根目录）----------
/_*.log
/_*.log.err
/_*.out
/_*.err
/it-test.log

# ---------- 前端构建与本地调试产物 ----------
web/dist/
web/tsconfig.tsbuildinfo
*.tsbuildinfo
web/dev.*.log
web/_dev_v4.out
web/.playwright-cli/
.vite/

# ---------- 设计源与本地预览（非交付物，不进版本库）----------
design/

# ---------- IDE / OS ----------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---------- 其它 ----------
*.bak*
data/
