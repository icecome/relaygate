# ===== relay-gate 服务 =====
PORT=19900
# 默认仅监听本机；跨机访问请显式配置（并自配防火墙）
HOST=127.0.0.1
# 对外 API Key（转发 API 调用方必须携带）；未配置时服务拒绝启动
API_KEY=
# 管理密钥（账号 CRUD / 面板数据 / 运维接口）；留空则回退 API_KEY 并告警
ADMIN_KEY=
# /status 是否免鉴权（默认 false = 需要 ADMIN_KEY 或 API_KEY）
STATUS_PUBLIC=false
# 数据工作目录（SQLite 凭据库、日志、session 等存放于此）
WORKSPACE_DIR=./output
# 日志级别：info（默认，仅关键事件）| debug（额外把每请求一行 traffic 打到 stdout）。
# 注意 stdout 在 start.bat 下重定向到 logs/relay.out.log 且无轮转，长期 debug 会让该文件持续增长。
LOG_LEVEL=info

# ===== 通知（可选）=====
# 通用 JSON Webhook / Server酱 / PushPlus / Telegram 可在管理面板配置。
# 事件级开关（签到成功/失败、积分临期、余额过低、Token 刷新失败、池空）
# 也写在面板 → 设置 → 提醒事件，存 .trae-api/notify-settings.json。
# NOTIFY_WEBHOOK_URL=https://example.com/hook
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# 同事件去重窗口（毫秒，默认 1h）
# NOTIFY_DEDUPE_MS=3600000
# 通知合并窗口（毫秒，默认 10min）：同事件在窗口内重复触发时，窗口结束补发一条合并摘要
# NOTIFY_MERGE_MS=600000

# ===== 余额自动刷新（可选）=====
# 面板「设置 → 余额自动刷新」保存后写入 .trae-api/balance-refresh-settings.json，文件值优先于 env。
# BALANCE_REFRESH_ENABLED=false
# BALANCE_REFRESH_INTERVAL_MINUTES=30

# ===== 全量备份（可选）=====
# 面板「设置 → 全量备份」保存后写入 .trae-api/backup-state.json。
# 备份密钥：TRAE_BACKUP_PASSPHRASE（≥16 字符）优先；缺省读取/生成 .trae-api/backup.key
# TRAE_BACKUP_PASSPHRASE=
# BACKUP_ENABLED=false
# BACKUP_DIR=./backups
# BACKUP_KEEP=5
# BACKUP_INTERVAL_HOURS=24

# ===== 凭据加密密钥 =====
# 用于加密 accounts 库中的 token/refreshToken。缺失时自动生成并持久化到
# .trae-api/encrypt.key（推荐固定设置，避免换机/重装后无法解密既有账号）。
# 必须是 64 位 hex（32 字节）。
TRAE_API_ENCRYPT_KEY=

# ===== 上游 Trae 端点（默认按版本自动识别，不必都填）=====
# TRAE_API_HOST=https://trae-api-cn.mchost.guru
# TRAE_AUTH_HOST=https://trae-api-cn.mchost.guru
# TRAE_EDITION=cn
# TRAE_MANUAL_TOKEN=
# 签到/权益类 UG 域（与 agent mchost 分离；日志实测 api.trae.cn）
# TRAE_UG_HOST=https://api.trae.cn

# ===== 重试 / 超时 =====
TRAE_MAX_RETRIES=3
TRAE_RETRY_DELAY=2000
TRAE_REQUEST_TIMEOUT_MS=600000

# ===== 工具调用协议：native(默认) / text =====
TOOL_PROTOCOL=native

# ===== 截断自动续写 =====
# 上游因输出上限中断（finish_reason=length）时，网关把已产出内容拼回上下文继续请求，
# 对客户端表现为一次完整回复。关闭（false）则如实透传截断信号，由客户端决定是否续写。
# AUTO_CONTINUE=false
# 单次请求最多续写轮数（0=不续写）；达到上限仍截断时，末帧如实标记 length。
# MAX_CONTINUES=5
# 残缺工具参数（半截 JSON）是否注入 __incomplete/__raw 诊断标记。
# 默认关闭：严格 schema 校验的客户端可能不认额外键。行为判定不受此开关影响。
# MARK_INCOMPLETE_TOOL_ARGS=false

# ===== 上游多模式（Phase E）=====
# 覆盖 chat function：chat_v3 | solo_work_lite | inline_chat | …（空=model-config）
# TRAE_UPSTREAM_FUNCTION=solo_work_lite
# chat 路径（默认 llm_utils_chat）
# TRAE_UPSTREAM_CHAT_PATH=/api/agent/v3/llm_utils_chat
# 旧格式逐请求 JSON 文件（默认关；默认写 traffic.jsonl + 控制台一行）
# LEGACY_TRAFFIC_FILES=false
# SSE 调试：true 时记录上游原始 SSE 事件到 logs/<date>/sse-debug.jsonl（T2）
# TRAE_DEBUG_SSE=false

# ===== 账号池 / 并发（Phase B）=====
# least_balance（积分优先，默认）| round_robin
POOL_STRATEGY=least_balance
# 单账号最大在途请求（对照社区常见值 2）
MAX_IN_FLIGHT_PER_ACCOUNT=2
# 余额低于该值不参与调度（0=不限制）
MIN_BALANCE_TO_USE=0

# ===== 定时任务（Phase A）=====
# 以下为默认值；面板「设置 → 定时任务」保存后写入
# .trae-api/scheduler-settings.json，文件值优先于 env。
SCHEDULER_ENABLED=true
# 每日签到（本地时区）
CHECKIN_HOUR=9
CHECKIN_MINUTE=0
# 每日 token 保活
KEEPALIVE_HOUR=22
KEEPALIVE_MINUTE=0
# Token 临期扫描间隔（分钟）
TOKEN_SWEEP_MINUTES=15
# Token 到期前多少小时预刷新
TOKEN_REFRESH_LEAD_HOURS=24
# 模型自动探活：间隔小时（0=关闭）；每轮最多探多少个未知模型
MODEL_PROBE_INTERVAL_HOURS=6
MODEL_PROBE_MAX_PER_RUN=8
# 成长中心独立轮询：开关 + 间隔小时（0=关闭；默认 4h，及时领奖/补派，对齐轮询补签模型）
GROWTH_POLL_ENABLED=true
GROWTH_POLL_INTERVAL_HOURS=4

# ===== 账号自动切换（轮换，可选）=====
# 面板「运行状态 → 账号自动切换」保存后写入 .trae-api/rotate-settings.json，文件值优先于 env。
# 原理：定时替换客户端 auth 文件触发 WorkBuddy 热加载，客户端自动执行每日活跃任务。
# ROTATE_ENABLED=true
# ROTATE_INTERVAL_MINUTES=240
# ROTATE_STAY_MS=60000
# ROTATE_AUTH_DIR=
# ROTATE_EXCLUDE_UIDS=
# ROTATE_SWITCH_BACK=true

# ===== 任务日志 =====
# TASK_LOG_MAX_ENTRIES=500

# ===== 统计缓存 =====
# STATS_CACHE=off 时 /stats/* 回退全量扫描（默认开启物化缓存）
# STATS_CACHE_OFF=true

# ===== 长上下文投影压缩 =====
# PROJECTION_ENABLED=true
# PROJECTION_MAX_SYSTEM=2000

# ===== 虚拟模型上下文窗口守门 =====
# 虚拟模型的窗口声明不在此处，写在 model-router.json 各虚拟模型的 contextWindow 字段
# （取候选模型真实窗口的最小值，如 Trae 通道 prompt_max_tokens=168000）。
# 声明后网关在分发前按字符级粗估输入 token，超过窗口 75% 显式返回 400
# （error.code=context_length_exceeded），客户端应自行压缩历史后重试；
# 不声明则不做拦截，超限时上游静默截断头部 → 会话记忆错乱/幻觉。

# ===== 客户端安装位置（用于读取版本号，非标准安装时填）=====
# TRAE_CLIENT_DIR=C:\Program Files\Trae

# ===== 设备头默认值（账号未自带 devices 时兜底）=====
# TRAE_DEVICE_ID=
# TRAE_MACHINE_ID=
# TRAE_APP_ID=6eefa01c-1036-4c7e-9ca5-d891f63bfcd8
# TRAE_OAUTH_CLIENT_ID=ono9krqynydwx5
# TRAE_OAUTH_CLIENT_SECRET=-
# TRAE_DEVICE_MODEL=82RF
# TRAE_CPU=Intel
# TRAE_OS_NAME=windows
# TRAE_OS_VERSION=Windows 10

# ===== 代理（可选）=====
# HTTP_PROXY=http://localhost:7891
# HTTPS_PROXY=http://localhost:7891
# ALL_PROXY=socks5://localhost:1083

# node scripts/login-key.js create   # 首次创建
# node scripts/login-key.js reset    # 轮换（旧密钥全部失效）
#node scripts/login-key.js list     # 列表（只显示 hint）
